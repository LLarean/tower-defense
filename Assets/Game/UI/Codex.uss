@import url("Theme.uss");

.screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.6);
}

.sheet {
    width: 780px;
    max-height: 86%;
    padding: 30px 40px;
}

.sheet-title {
    font-size: 38px;
    color: var(--ink);
    -unity-text-align: middle-center;
}

.sheet-hint {
    font-size: 16px;
    color: var(--ink-soft);
    margin-bottom: 12px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.codex-list {
    flex-shrink: 1;
}

.codex-row {
    padding: 8px 4px;
    border-bottom-width: 1px;
    border-color: rgba(90, 60, 35, 0.25);
}

.codex-name {
    font-size: 20px;
    color: var(--ink);
    -unity-font-style: bold;
}

.codex-text {
    font-size: 16px;
    color: var(--ink-soft);
    white-space: normal;
}

.sheet-button {
    align-self: center;
    margin-top: 14px;
    font-size: 22px;
    padding: 8px 40px;
    min-height: 46px;
}

.hidden {
    display: none;
}
