@import url("Theme.uss");

.hud {
    flex-grow: 1;
    justify-content: space-between;
}

.hidden {
    display: none;
}

.overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.bar {
    flex-direction: row;
    align-items: center;
    align-self: center;
    padding: 6px 14px;
    margin: 10px;
    background-color: var(--night);
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--night-line);
}

.icon {
    width: 28px;
    height: 28px;
    margin-left: 10px;
    -unity-background-scale-mode: scale-to-fit;
}

.coin {
    background-image: url("Skin/Coin.png");
}

.shield {
    background-image: url("Skin/Shield.png");
    -unity-background-image-tint-color: rgb(255, 150, 140);
}

.stat {
    font-size: 22px;
    color: rgb(235, 238, 245);
    margin: 0 14px 0 6px;
    -unity-font-style: bold;
}

.gold {
    color: var(--gold);
}

.lives {
    color: rgb(255, 140, 130);
}

.wave {
    font-size: 24px;
    -unity-font-style: normal;
    margin-left: 18px;
}

.summon {
    font-size: 18px;
    padding: 6px 16px;
    margin-left: 14px;
    border-radius: 8px;
    border-width: 0;
    color: rgb(30, 22, 12);
    background-color: var(--gold);
    -unity-font-style: bold;
}

.summon:hover {
    background-color: rgb(255, 225, 150);
}

.tool {
    margin-left: 8px;
    color: rgb(235, 238, 245);
    background-color: rgba(255, 255, 255, 0.1);
    -unity-font-style: normal;
}

.tool:hover {
    background-color: rgba(255, 255, 255, 0.2);
}

.slot {
    width: 104px;
    height: 112px;
    margin: 0 4px;
    padding: 4px 4px 6px 4px;
    align-items: center;
    justify-content: flex-end;
    border-radius: 10px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.15);
    background-color: rgba(34, 40, 54, 0.95);
    color: rgb(235, 238, 245);
}

.slot:hover {
    background-color: rgba(52, 60, 80, 0.98);
    border-color: rgba(255, 255, 255, 0.75);
}

.slot--poor {
    opacity: 0.45;
}

.slot-icon {
    position: absolute;
    left: 6px;
    right: 6px;
    top: 2px;
    bottom: 26px;
    -unity-background-scale-mode: scale-to-fit;
}

.slot-key {
    position: absolute;
    left: 6px;
    top: 4px;
    font-size: 15px;
    color: rgba(255, 255, 255, 0.75);
    -unity-font-style: bold;
}

.slot-price {
    font-size: 17px;
    color: var(--gold);
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.8);
}

.slot--fire { border-color: rgba(255, 120, 50, 0.7); }
.slot--water { border-color: rgba(80, 160, 255, 0.7); }
.slot--ice { border-color: rgba(170, 230, 255, 0.7); }
.slot--lightning { border-color: rgba(255, 230, 90, 0.7); }
.slot--poison { border-color: rgba(130, 230, 90, 0.7); }
.slot--earth { border-color: rgba(210, 160, 100, 0.7); }
.slot--oil { border-color: rgba(170, 130, 220, 0.7); }

.panel {
    position: absolute;
    right: 12px;
    top: 80px;
    width: 340px;
    padding: 14px 16px;
    background-color: var(--night);
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--night-line);
}

.title {
    font-size: 24px;
    color: var(--gold);
}

.stats {
    font-size: 17px;
    color: rgb(205, 210, 220);
    margin: 6px 0;
    white-space: normal;
}

.actions {
    flex-direction: row;
}

.action {
    flex-grow: 1;
    font-size: 15px;
    padding: 6px;
    border-radius: 6px;
    border-width: 0;
    color: rgb(20, 24, 30);
    background-color: rgb(140, 220, 140);
    -unity-font-style: bold;
}

.sell {
    background-color: rgb(230, 150, 120);
}

.tooltip {
    position: absolute;
    bottom: 140px;
    align-self: center;
    max-width: 560px;
    padding: 12px 16px;
    font-size: 16px;
    color: rgb(225, 230, 240);
    background-color: rgba(16, 20, 30, 0.95);
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--night-line);
    white-space: normal;
}

.hint {
    position: absolute;
    top: 66px;
    align-self: center;
    padding: 8px 18px;
    font-size: 17px;
    color: var(--gold);
    background-color: var(--night);
    border-radius: 8px;
}

.verdict {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.5);
}

.dialog {
    min-width: 380px;
    padding: 28px 40px 32px 40px;
}

.page {
    align-items: center;
}

.outcome {
    font-size: 52px;
    color: var(--ink);
    margin-bottom: 14px;
}

.heading {
    font-size: 34px;
    color: var(--ink);
    margin-bottom: 12px;
}

.lines {
    font-size: 17px;
    color: var(--ink);
    margin-bottom: 12px;
    white-space: normal;
}

.story {
    max-width: 540px;
    font-size: 19px;
    -unity-text-align: upper-center;
}

.again {
    width: 260px;
    min-height: 46px;
    margin: 4px;
    font-size: 21px;
}

.back {
    margin-top: 14px;
}

.next {
    display: none;
}

.verdict--won .next {
    display: flex;
}

.caption {
    position: absolute;
    translate: -50% -50%;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
    text-shadow: 1px 2px 2px rgba(0, 0, 0, 0.6);
    white-space: nowrap;
}

.caption--heavy {
    font-size: 30px;
}

.caption--reaction {
    font-size: 34px;
    -unity-font-definition: url("../../Fonts/Sources/MedievalSharp.ttf");
    -unity-font-style: normal;
    -unity-text-outline-width: 1.5px;
}

.bossbar {
    position: absolute;
    top: 64px;
    left: 30%;
    right: 30%;
    align-items: center;
}

.boss-title {
    font-size: 24px;
    color: rgb(255, 160, 130);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.85);
}

.boss-track {
    width: 100%;
    height: 14px;
    margin-top: 4px;
    background-color: var(--night);
    border-radius: 7px;
    border-width: 1px;
    border-color: var(--night-line);
    overflow: hidden;
}

.boss-fill {
    width: 100%;
    height: 100%;
    background-color: rgb(220, 70, 60);
}

.nowrap {
    white-space: nowrap;
}
