.menu {
    flex-grow: 1;
    justify-content: center;
    align-items: flex-start;
    padding-left: 80px;
}

.card {
    min-width: 560px;
    padding: 28px;
    background-color: rgba(18, 22, 30, 0.86);
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
}

.title {
    font-size: 40px;
    color: rgb(255, 214, 120);
    -unity-font-style: bold;
    margin-bottom: 18px;
}

.caption {
    font-size: 16px;
    color: rgb(170, 178, 192);
    margin: 14px 0 4px 2px;
}

.row {
    flex-direction: row;
    align-items: center;
}

.choice {
    font-size: 20px;
    padding: 10px 18px;
    margin: 4px;
    border-radius: 8px;
    border-width: 0;
    color: rgb(235, 238, 245);
    background-color: rgb(52, 60, 78);
}

.choice:hover {
    background-color: rgb(72, 82, 104);
}

.primary {
    color: rgb(20, 24, 30);
    background-color: rgb(255, 196, 70);
}

.primary:hover {
    background-color: rgb(255, 220, 120);
}

.quit {
    margin-top: 18px;
}

.field {
    flex-grow: 1;
    font-size: 20px;
    margin: 4px;
}

.roster {
    font-size: 24px;
    color: rgb(235, 238, 245);
    margin-bottom: 12px;
    white-space: normal;
}

.status {
    font-size: 16px;
    color: rgb(255, 150, 130);
    margin-top: 14px;
    white-space: normal;
}

.hidden {
    display: none;
}

.field .unity-text-field__input {
    background-color: rgb(32, 38, 50);
    color: rgb(235, 238, 245);
    border-color: rgba(255, 255, 255, 0.18);
    border-radius: 6px;
    padding: 6px 10px;
}

.grow {
    flex-grow: 1;
}

.overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.page > .choice {
    margin: 5px 4px;
}

.wide {
    width: 920px;
}

.top {
    align-items: flex-start;
    margin-bottom: 14px;
}

.mission-list {
    width: 280px;
    margin-right: 18px;
}

.mission {
    -unity-text-align: middle-left;
    border-left-width: 4px;
    border-left-color: rgba(0, 0, 0, 0);
}

.mission--done {
    border-left-color: rgb(140, 220, 140);
}

.mission--locked {
    opacity: 0.4;
}

.mission--chosen,
.tier--chosen {
    background-color: rgb(92, 104, 132);
}

.mission-detail {
    flex-grow: 1;
    flex-shrink: 1;
}

.heading {
    font-size: 28px;
    color: rgb(255, 230, 150);
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.story {
    font-size: 18px;
    color: rgb(220, 225, 235);
    white-space: normal;
    margin-bottom: 14px;
    max-width: 640px;
}

.hint {
    font-size: 15px;
    color: rgb(170, 178, 192);
    white-space: normal;
    margin: 4px 2px;
}

.back {
    background-color: rgb(40, 46, 60);
}
