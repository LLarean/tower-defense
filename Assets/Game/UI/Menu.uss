@import url("Theme.uss");

.menu {
    flex-grow: 1;
    justify-content: center;
    align-items: flex-start;
    padding-left: 80px;
}

.card {
    min-width: 560px;
    padding: 30px 40px 34px 40px;
}

.title {
    font-size: 44px;
    color: var(--ink);
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

.caption {
    font-size: 16px;
    color: var(--ink-soft);
    margin: 14px 0 4px 2px;
}

.row {
    flex-direction: row;
    align-items: center;
}

.choice {
    font-size: 22px;
    padding: 10px 22px;
    margin: 4px;
    min-height: 48px;
}

.page > .choice {
    margin: 5px 40px;
}

.quit {
    margin-top: 18px;
}

.field {
    flex-grow: 1;
    font-size: 20px;
    margin: 4px;
}

.field .unity-text-field__input {
    background-color: rgba(255, 250, 235, 0.75);
    color: var(--ink);
    border-color: rgba(90, 60, 35, 0.6);
    border-width: 1px;
    border-radius: 4px;
    padding: 8px 10px;
}

.roster {
    font-size: 24px;
    color: var(--ink);
    margin-bottom: 12px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.status {
    font-size: 16px;
    color: rgb(150, 40, 25);
    margin-top: 14px;
    white-space: normal;
}

.hidden {
    display: none;
}

.grow {
    flex-grow: 1;
}

.overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.wide {
    width: 960px;
}

.top {
    align-items: flex-start;
    margin-bottom: 14px;
}

.mission-list {
    width: 280px;
    margin-right: 22px;
    padding-right: 14px;
    border-right-width: 1px;
    border-color: rgba(90, 60, 35, 0.35);
}

.mission {
    font-size: 20px;
    padding: 10px 14px;
    margin: 3px 0;
    -unity-text-align: middle-left;
    color: var(--ink);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-left-width: 4px;
    border-left-color: rgba(0, 0, 0, 0);
    border-radius: 0;
}

.mission:hover {
    background-color: rgba(120, 80, 40, 0.12);
}

.mission--done {
    border-left-color: rgb(80, 140, 60);
}

.mission--locked {
    opacity: 0.4;
}

.mission--chosen {
    background-image: url("Skin/Title.png");
    -unity-slice-left: 12;
    -unity-slice-right: 12;
    -unity-slice-top: 12;
    -unity-slice-bottom: 12;
    color: var(--cream);
}

.mission-detail {
    flex-grow: 1;
    flex-shrink: 1;
}

.heading {
    font-size: 32px;
    color: var(--ink);
    margin-bottom: 8px;
}

.story {
    font-size: 19px;
    color: var(--ink);
    white-space: normal;
    margin-bottom: 16px;
    max-width: 640px;
}

.hint {
    font-size: 15px;
    color: var(--ink-soft);
    white-space: normal;
    margin: 4px 2px;
}
