<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="Codex" src="Codex.uxml" />
    <Style src="Hud.uss" />
    <ui:VisualElement name="captions" class="overlay" picking-mode="Ignore" />
    <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
        <ui:VisualElement name="top" class="bar top">
            <ui:Label name="gold" class="stat gold" />
            <ui:Label name="lives" class="stat lives" />
            <ui:Label name="wave" class="stat wave" />
            <ui:Button name="summon" class="summon" />
            <ui:Button name="speed" class="summon tool" />
            <ui:Button name="open-menu" class="summon tool" text="Menu" />
        </ui:VisualElement>
        <ui:VisualElement name="inspector" class="panel inspector">
            <ui:Label name="title" class="title" />
            <ui:Label name="stats" class="stats" />
            <ui:VisualElement class="actions">
                <ui:Button name="upgrade" class="action upgrade" />
                <ui:Button name="sell" class="action sell" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="tooltip" class="tooltip" />
        <ui:VisualElement name="arsenal" class="bar bottom" />
        <ui:VisualElement name="verdict" class="verdict">
            <ui:Label name="outcome" class="outcome" />
            <ui:Button name="again" class="action again" text="Play again" />
            <ui:Button name="verdict-menu" class="action again" text="Main menu" />
        </ui:VisualElement>
        <ui:VisualElement name="pause" class="verdict">
            <ui:VisualElement class="sheet">
                <ui:VisualElement name="pause-main" class="page">
                    <ui:Label class="outcome" text="Paused" />
                    <ui:Button name="resume" class="action again" text="Resume" />
                    <ui:Button name="restart" class="action again" text="Restart mission" />
                    <ui:Button name="settings" class="action again" text="Settings" />
                    <ui:Button name="controls" class="action again" text="Controls" />
                    <ui:Button name="codex" class="action again" text="Codex" />
                    <ui:Button name="cheats" class="action again" text="Debug" />
                    <ui:Button name="menu" class="action again" text="Main menu" />
                    <ui:Button name="quit" class="action again sell" text="Quit game" />
                </ui:VisualElement>
                <ui:VisualElement name="pause-settings" class="page">
                    <ui:Label class="heading" text="Settings" />
                    <ui:Button name="numbers" class="action again" />
                    <ui:Button class="action again back" text="Back" />
                </ui:VisualElement>
                <ui:VisualElement name="pause-controls" class="page">
                    <ui:Label class="heading" text="Controls" />
                    <ui:Label class="lines" text="1–7  choose a tower&#10;Left click  build or select&#10;Right click  cancel&#10;U  upgrade selected tower&#10;X  sell selected tower&#10;Space  start or call the next wave&#10;WASD, arrows, screen edge  move camera&#10;Mouse wheel  zoom&#10;Esc  back or pause" />
                    <ui:Button class="action again back" text="Back" />
                </ui:VisualElement>
                <ui:VisualElement name="pause-cheats" class="page">
                    <ui:Label class="heading" text="Debug" />
                    <ui:Button name="cheat-gold" class="action again" text="+1000 gold" />
                    <ui:Button name="cheat-lives" class="action again" text="+10 lives" />
                    <ui:Button name="cheat-wave" class="action again" text="Call next wave" />
                    <ui:Button name="cheat-kill" class="action again sell" text="Kill all monsters" />
                    <ui:Button class="action again back" text="Back" />
                </ui:VisualElement>
                <ui:VisualElement name="pause-prompt" class="page">
                    <ui:Label name="prompt-question" class="heading" />
                    <ui:Label class="lines" text="Progress in this mission will be lost." />
                    <ui:Button name="prompt-yes" class="action again sell" text="Yes" />
                    <ui:Button class="action again back" text="Cancel" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Instance template="Codex" class="overlay" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
